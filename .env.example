APP_ENV=development
APP_NAME=Go Starter Kit
PORT=3000
LOG_LEVEL=info

# Database Master Default Connection (sqlite1, pg1, mysql1, mongo1)
DB_DEFAULT_CONNECTION=sqlite1

# SQLite Databases
DB_SQLITE_ENABLED=true
DB_SQLITE_1_PATH=storages/database/sqlite1.dev.db
DB_SQLITE_2_PATH=storages/database/sqlite2.dev.db
DB_SQLITE_3_PATH=storages/database/sqlite3.dev.db

# PostgreSQL Databases
DB_PG_ENABLED=false
DB_PG_1_DSN=postgres://postgres:postgres@localhost:5432/db1?sslmode=disable
DB_PG_2_DSN=
DB_PG_3_DSN=

# MySQL Databases
DB_MYSQL_ENABLED=false
DB_MYSQL_1_DSN=root:root@tcp(localhost:3306)/db1?parseTime=true
DB_MYSQL_2_DSN=
DB_MYSQL_3_DSN=

# MongoDB Databases
DB_MONGO_ENABLED=false
DB_MONGO_1_URI=mongodb://localhost:27017/db1
DB_MONGO_2_URI=
DB_MONGO_3_URI=

# Redis Broker (Distributed Cache & Asynq Task Queue)
REDIS_URL=redis://localhost:6379

# Mail System (Drivers: log, smtp, resend)
MAIL_DRIVER=log
MAIL_FROM_NAME="Go Starter Kit"
MAIL_FROM_EMAIL=noreply@example.com
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_RESEND_API_KEY=
