package emails

templ Welcome(name string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<title>Welcome to Go Starter Kit</title>
		</head>
		<body style="font-family: sans-serif; padding: 20px; line-height: 1.6; color: #333;">
			<h1 style="color: #2563eb;">Selamat Datang, { name }!</h1>
			<p>Terima kasih telah bergabung dengan kami di <strong>Go Starter Kit</strong>.</p>
			<p>Akun Anda siap digunakan untuk mengeksplorasi seluruh fitur sistem.</p>
		</body>
	</html>
}
